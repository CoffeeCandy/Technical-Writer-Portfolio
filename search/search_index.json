{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to Evelyn","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"about/","title":"About","text":"<p>\u5728\u8bbe\u8ba1\u5bfc\u822a\u7ed3\u6784\u65f6\uff0c\u5e94\u4f18\u5148\u8003\u8651\u8bfb\u8005\u7684\u9605\u8bfb\u4f53\u9a8c\uff1a</p> <p>\u5b66\u4e60\u8def\u5f84\u662f\u5426\u6e05\u6670</p> <p>\u662f\u5426\u7b26\u5408\u4ece\u6d45\u5230\u6df1\u7684\u903b\u8f91</p> <p>\u662f\u5426\u907f\u514d\u5bfc\u822a\u5c42\u7ea7\u8fc7\u6df1</p> <p>\u5bfc\u822a\u4e0d\u5fc5\u4e25\u683c\u53cd\u6620\u76ee\u5f55\u7ed3\u6784\uff0c\u800c\u5e94\u53cd\u6620\u5185\u5bb9\u7684\u903b\u8f91\u5173\u7cfb\u3002</p>"},{"location":"portfolio/mkdocs/advance-usage/","title":"\u9ad8\u7ea7\u7528\u6cd5","text":""},{"location":"portfolio/mkdocs/advance-usage/#_2","title":"\u81ea\u5b9a\u4e49\u4e3b\u9898","text":""},{"location":"portfolio/mkdocs/advance-usage/#github-pages","title":"\u6587\u6863\u90e8\u7f72\u5230GitHub Pages","text":"<p>\u786e\u4fdd\u4f60\u7684\u9879\u76ee\u5728 GitHub \u4ed3\u5e93</p> <p>\u4f7f\u7528\u4ee5\u4e0b\u547d\u4ee4\u90e8\u7f72\uff1a</p> <p>mkdocs gh-deploy</p> <p>\u8be5\u547d\u4ee4\u4f1a\u81ea\u52a8\u6784\u5efa\u5e76\u5c06 site \u76ee\u5f55\u5185\u5bb9\u63a8\u9001\u5230 GitHub Pages \u5206\u652f\u3002</p> <p>4.2 \u90e8\u7f72\u5230\u5176\u4ed6\u9759\u6001\u670d\u52a1\u5668</p> <p>\u5c06 site \u76ee\u5f55\u5185\u5bb9\u4e0a\u4f20\u5230\u4f60\u7684\u670d\u52a1\u5668\u5bf9\u5e94\u7684\u9759\u6001\u8d44\u6e90\u76ee\u5f55\u5373\u53ef\u3002</p>"},{"location":"portfolio/mkdocs/advance-usage/#_3","title":"\u6027\u80fd\u4e0e\u6784\u5efa\u4f18\u5316","text":""},{"location":"portfolio/mkdocs/appendix/","title":"\u9644\u5f55","text":""},{"location":"portfolio/mkdocs/appendix/#_1","title":"\u914d\u7f6e\u9879\u53c2\u8003","text":""},{"location":"portfolio/mkdocs/appendix/#_2","title":"\u5e38\u89c1\u9519\u8bef\u8bf4\u660e","text":""},{"location":"portfolio/mkdocs/appendix/#_3","title":"\u672f\u8bed\u8868","text":""},{"location":"portfolio/mkdocs/concepts/","title":"mkdocs\u7528\u6237\u6307\u5357","text":""},{"location":"portfolio/mkdocs/concepts/#_1","title":"\u4e00\u3001\u9879\u76ee\u7ed3\u6784\u8bf4\u660e","text":"<ul> <li>docs/ \uff1a\u5b58\u653e\u6240\u6709\u6587\u6863\u5185\u5bb9\uff0cMarkdown \u6587\u4ef6\u96c6\u4e2d\u7ba1\u7406\u3002  </li> <li>docs/index.md \uff1a\u7f51\u7ad9\u9996\u9875\uff0c\u901a\u5e38\u4e3a\u9879\u76ee\u7b80\u4ecb\u6216\u6b22\u8fce\u9875\u3002  </li> <li>docs/concepts/ \uff1a\u5b58\u653e\u6982\u5ff5\u7c7b\u6587\u6863\uff0c\u4ecb\u7ecd\u9879\u76ee\u6838\u5fc3\u7406\u5ff5\u548c\u57fa\u7840\u77e5\u8bc6\u3002  </li> <li>docs/how-to-guides/ \uff1a\u5b58\u653e\u64cd\u4f5c\u6307\u5357\uff0c\u5e2e\u52a9\u7528\u6237\u4e00\u6b65\u6b65\u5b8c\u6210\u4efb\u52a1\u3002  </li> <li>docs/assets/ \uff1a\u5b58\u653e\u56fe\u7247\u3001\u56fe\u6807\u7b49\u9759\u6001\u8d44\u6e90\uff0c\u4f9b\u6587\u6863\u5f15\u7528\u3002  </li> <li>mkdocs.yml \uff1aMkDocs \u7684\u6838\u5fc3\u914d\u7f6e\u6587\u4ef6\uff0c\u5b9a\u4e49\u7f51\u7ad9\u7ed3\u6784\u3001\u4e3b\u9898\u7b49\u3002  </li> <li>requirements.txt \uff1aPython \u4f9d\u8d56\u5217\u8868\uff0c\u65b9\u4fbf\u73af\u5883\u642d\u5efa\u3002</li> </ul> <p>\u901a\u8fc7\u8be5\u7ed3\u6784\uff0c\u9879\u76ee\u6587\u6863\u903b\u8f91\u6e05\u6670\uff0c\u4fbf\u4e8e\u65b0\u589e\u6587\u6863\u548c\u7ef4\u62a4\u3002</p>"},{"location":"portfolio/mkdocs/concepts/#_2","title":"\u4e8c\u3001\u914d\u7f6e\u6587\u4ef6\u8bf4\u660e","text":""},{"location":"portfolio/mkdocs/concepts/#1","title":"1. \u6982\u89c8","text":"<ul> <li>MkDocs \u4f7f\u7528 mkdocs.yml \u4f5c\u4e3a\u5168\u5c40\u914d\u7f6e\u6587\u4ef6\uff0c\u7528\u4e8e\u63a7\u5236\u6574\u4e2a\u6587\u6863\u7ad9\u70b9\u7684\u884c\u4e3a\u548c\u5916\u89c2\uff0c\u5305\u62ec\uff1a<ul> <li>\u7ad9\u70b9\u57fa\u672c\u4fe1\u606f\uff08\u540d\u79f0\u3001\u5730\u5740\u7b49\uff09</li> <li>\u5de6\u4fa7\u5bfc\u822a\u7ed3\u6784</li> <li>\u4e3b\u9898\u4e0e\u5916\u89c2\u8bbe\u7f6e</li> <li>\u63d2\u4ef6\u4e0e\u6269\u5c55\u529f\u80fd</li> </ul> </li> </ul>"},{"location":"portfolio/mkdocs/concepts/#2","title":"2. \u57fa\u672c\u7ed3\u6784","text":"<ul> <li>mkdocs.yml\u4f7f\u7528 YAML \u683c\u5f0f\u8fdb\u884c\u7f16\u5199\uff0c\u5176\u57fa\u672c\u5f62\u5f0f\u4e3a \u952e\u503c\u5bf9\uff08key: value\uff09\u3002</li> </ul> <pre><code>    site_name: My Docs\n</code></pre>"},{"location":"portfolio/mkdocs/concepts/#3","title":"3. \u5e38\u7528\u6838\u5fc3\u914d\u7f6e\u9879","text":"<ul> <li>site_name\uff08\u7ad9\u70b9\u540d\u79f0\uff09:\u7528\u4e8e\u6307\u5b9a\u6587\u6863\u7ad9\u70b9\u7684\u540d\u79f0\uff0c\u901a\u5e38\u4f1a\u663e\u793a\u5728\uff1a\u6d4f\u89c8\u5668\u6807\u7b7e\u9875\u6807\u9898 \u548c \u9875\u9762\u9876\u90e8\u5bfc\u822a\u680f</li> </ul> <pre><code>    site_name: MkDocs \u7528\u6237\u6307\u5357\n</code></pre> <ul> <li>site_url\uff08\u7ad9\u70b9\u5730\u5740\uff0c\u53ef\u9009\uff09: \u7528\u4e8e\u6307\u5b9a\u7ad9\u70b9\u7684\u8bbf\u95ee\u5730\u5740\uff0c\u5728\u4ee5\u4e0b\u573a\u666f\u4e2d\u975e\u5e38\u6709\u7528\uff1a<ul> <li>\u90e8\u7f72\u5230 GitHub Pages</li> <li>\u542f\u7528 SEO \u6216\u7ad9\u70b9\u5730\u56fe\u63d2\u4ef6</li> </ul> </li> </ul> <pre><code>site_url: https://example.github.io/mkdocs-guide/\n</code></pre> <ul> <li>nav\uff08\u5bfc\u822a\u914d\u7f6e\uff09:\u7528\u4e8e\u5b9a\u4e49\u6587\u6863\u7ad9\u70b9\u5de6\u4fa7\u7684\u5bfc\u822a\u7ed3\u6784\uff0c\u662f\u914d\u7f6e\u4e2d\u6700\u91cd\u8981\u3001\u4e5f\u6700\u5bb9\u6613\u51fa\u9519\u7684\u90e8\u5206\u3002<ul> <li>\u57fa\u672c\u89c4\u5219<ul> <li>\u5bfc\u822a\u987a\u5e8f\u4e0e <code>nav</code> \u4e2d\u7684\u5b9a\u4e49\u987a\u5e8f\u4e00\u81f4</li> <li>\u6587\u4ef6\u8def\u5f84\u5fc5\u987b\u771f\u5b9e\u5b58\u5728</li> <li>\u652f\u6301\u591a\u7ea7\u5bfc\u822a</li> </ul> </li> </ul> </li> </ul> <pre><code>    nav:\n    - \u9996\u9875: index.md\n    - \u5feb\u901f\u5f00\u59cb: getting-started.md\n    - \u4f7f\u7528\u6307\u5357:\n        - \u5b89\u88c5: guide/install.md\n        - \u914d\u7f6e\u6587\u4ef6\u8bf4\u660e: guide/configure\n</code></pre>"},{"location":"portfolio/mkdocs/how-to-guide/","title":"\u64cd\u4f5c\u6307\u5357","text":""},{"location":"portfolio/mkdocs/how-to-guide/#_2","title":"\u4e00\u3001\u65b0\u589e\u9875\u9762","text":""},{"location":"portfolio/mkdocs/how-to-guide/#1","title":"1.\u80cc\u666f:","text":"<p>\u5f53\u4f60\u9700\u8981\u8865\u5145\u65b0\u7684\u6587\u6863\u5185\u5bb9\uff0c\u5982\u65b0\u589e\u529f\u80fd\u8bf4\u660e\u3001FAQ\u3001\u6559\u7a0b\u7ae0\u8282\u7b49\uff0c\u5c31\u9700\u8981\u65b0\u589e\u9875\u9762\u3002</p>"},{"location":"portfolio/mkdocs/how-to-guide/#2","title":"2.\u57fa\u672c\u6d41\u7a0b:","text":"<ul> <li>\u5728 docs/ \u76ee\u5f55\u4e0b\u521b\u5efa\u65b0\u7684 Markdown \u6587\u4ef6</li> <li>\u7f16\u5199\u9875\u9762\u5185\u5bb9\uff08\u6dfb\u52a0\u6807\u9898\u548c\u6b63\u6587\uff09</li> <li>\u5728 mkdocs.yml \u914d\u7f6e\u6587\u4ef6\u4e2d\u5c06\u65b0\u9875\u9762\u52a0\u5165\u5bfc\u822a</li> <li>\u672c\u5730\u9884\u89c8\u6216\u6784\u5efa\u7ad9\u70b9\uff0c\u786e\u8ba4\u9875\u9762\u663e\u793a\u6b63\u5e38</li> </ul>"},{"location":"portfolio/mkdocs/how-to-guide/#3","title":"3.\u8be6\u7ec6\u6d41\u7a0b:","text":"<ol> <li> <p>\u521b\u5efa Markdown \u6587\u4ef6</p> <ul> <li>\u8fdb\u5165\u9879\u76ee\u4e2d\u7684 docs/ \u76ee\u5f55</li> <li>\u65b0\u5efa\u4e00\u4e2a .md \u683c\u5f0f\u7684\u6587\u4ef6\uff0c\u4f8b\u5982 new-feature.md</li> <li>\u5efa\u8bae\u6587\u4ef6\u540d\u4f7f\u7528\u5c0f\u5199\u5b57\u6bcd\u548c\u77ed\u6a2a\u7ebf\uff0c\u907f\u514d\u5927\u5c0f\u5199\u548c\u7a7a\u683c\u95ee\u9898</li> </ul> </li> <li> <p>\u7f16\u5199\u9875\u9762\u5185\u5bb9</p> <ul> <li>\u6253\u5f00\u65b0\u5efa\u7684 Markdown \u6587\u4ef6,\u6dfb\u52a0\u4e00\u7ea7\u6807\u9898\uff0c\u6807\u9898\u4f1a\u4f5c\u4e3a\u9875\u9762\u7684\u6807\u9898\u663e\u793a\u5728\u6d4f\u89c8\u5668\u548c\u5bfc\u822a\u4e2d</li> <li>\u6ce8\u610f\uff1a\u6587\u4ef6\u540d\u548c\u9875\u9762\u6807\u9898\u4e0d\u5fc5\u5b8c\u5168\u76f8\u540c\uff0c\u9875\u9762\u6807\u9898\u4ee5 Markdown \u4e2d\u7684\u4e00\u7ea7\u6807\u9898\u4e3a\u51c6\u3002</li> </ul> </li> <li>\u5c06\u9875\u9762\u52a0\u5165\u5bfc\u822a<ul> <li>\u6253\u5f00\u9879\u76ee\u6839\u76ee\u5f55\u4e0b\u7684 mkdocs.yml \u6587\u4ef6</li> <li>\u627e\u5230 nav \u914d\u7f6e\u9879</li> <li>\u6309\u7167\u5bfc\u822a\u5c42\u7ea7\uff0c\u65b0\u589e\u5bf9\u5e94\u9875\u9762\u7684\u8def\u5f84\uff08\u76f8\u5bf9\u4e8e docs/ \u76ee\u5f55\uff09</li> </ul> </li> </ol> <pre><code>nav:\n    - \u9996\u9875: index.md\n    - \u65b0\u529f\u80fd:\n        - \u65b0\u529f\u80fd\u4ecb\u7ecd: new-feature.md\n</code></pre> <p>\u91cd\u8981\uff1a\u5982\u679c\u4e0d\u5c06\u9875\u9762\u52a0\u5165 nav\uff0c\u8be5\u9875\u9762\u4e0d\u4f1a\u663e\u793a\u5728\u5de6\u4fa7\u5bfc\u822a\u680f\u3002</p> <ol> <li>\u9884\u89c8\u9875\u9762\u6548\u679c<ul> <li>\u5728\u547d\u4ee4\u884c\u6267\u884c\uff1a<code>mkdocs serve</code></li> <li>\u6253\u5f00\u6d4f\u89c8\u5668\uff0c\u8bbf\u95ee\u9ed8\u8ba4\u5730\u5740 http://127.0.0.1:8000</li> <li>\u5728\u5de6\u4fa7\u5bfc\u822a\u680f\u627e\u5230\u65b0\u589e\u9875\u9762</li> <li>\u70b9\u51fb\u786e\u8ba4\u5185\u5bb9\u663e\u793a\u6b63\u5e38</li> </ul> </li> </ol>"},{"location":"portfolio/mkdocs/how-to-guide/#_3","title":"\u4e8c\u3001\u4f7f\u7528\u548c\u5207\u6362\u4e3b\u9898","text":""},{"location":"portfolio/mkdocs/how-to-guide/#1_1","title":"1. \u4e3b\u9898\u7b80\u4ecb","text":"<ul> <li>\u4e3b\u9898\u51b3\u5b9a\u4e86\u6587\u6863\u7ad9\u70b9\u7684\u6574\u4f53\u89c6\u89c9\u98ce\u683c\u548c\u5e03\u5c40\u3002MkDocs \u9ed8\u8ba4\u63d0\u4f9b\u4e86\u51e0\u4e2a\u5185\u7f6e\u4e3b\u9898\uff0c\u4e5f\u652f\u6301\u7b2c\u4e09\u65b9\u4e3b\u9898\uff0c\u5982\u5e7f\u53d7\u6b22\u8fce\u7684 Material \u4e3b\u9898\u3002\u4f60\u53ef\u4ee5\u5728 MkDocs \u5b98\u65b9\u6587\u6863\u67e5\u770b\u66f4\u591a\u4e3b\u9898\u4fe1\u606f\u3002</li> </ul>"},{"location":"portfolio/mkdocs/how-to-guide/#2_1","title":"2. \u914d\u7f6e\u4e3b\u9898","text":"<ul> <li>\u6587\u4ef6\u4f4d\u7f6e: <ul> <li>\u4e3b\u9898\u914d\u7f6e\u5199\u5728\u9879\u76ee\u6839\u76ee\u5f55\u4e0b\u7684 mkdocs.yml \u6587\u4ef6\u4e2d\uff0c\u901a\u8fc7 theme \u5173\u952e\u5b57\u6307\u5b9a\u3002</li> </ul> </li> <li>\u4f7f\u7528\u5185\u7f6e\u4e3b\u9898</li> </ul> <pre><code>    theme:\n        name: mkdocs\n</code></pre> <ul> <li>\u4f7f\u7528 Material \u4e3b\u9898  <ul> <li>Material \u4e3b\u9898\u9700\u8981\u5148\u5b89\u88c5\uff1a<code>pip install mkdocs-material</code></li> <li>\u7136\u540e\u5728\u914d\u7f6e\u6587\u4ef6\u4e2d\u6307\u5b9a\uff1a</li> </ul> </li> </ul> <pre><code>    theme:\n        name: material\n</code></pre>"},{"location":"portfolio/mkdocs/introduce/","title":"mkdocs\u7528\u6237\u6307\u5357","text":""},{"location":"portfolio/mkdocs/introduce/#mkdocs_1","title":"\u4ec0\u4e48\u662fmkdocs","text":"<p>MkDocs \u662f\u4e00\u4e2a\u4ee5\u6587\u6863\u4e3a\u4e2d\u5fc3\u7684\u9759\u6001\u7ad9\u70b9\u751f\u6210\u5de5\u5177\uff0c\u5b83\u5c06\u5185\u5bb9\u3001\u7ed3\u6784\u548c\u6837\u5f0f\u6e05\u6670\u5206\u79bb\uff1a\u5185\u5bb9\u7528 Markdown \u7f16\u5199\uff0c\u7ed3\u6784\u901a\u8fc7\u914d\u7f6e\u6587\u4ef6\u5b9a\u4e49\uff0c\u6837\u5f0f\u7531\u4e3b\u9898\u63a7\u5236\u3002\u5b83\u7684\u8bbe\u8ba1\u76ee\u6807\u662f\u964d\u4f4e\u6587\u6863\u7ef4\u62a4\u6210\u672c\uff0c\u8ba9\u5f00\u53d1\u8005\u548c\u6587\u6863\u5de5\u7a0b\u5e08\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u5185\u5bb9\u672c</p>"},{"location":"portfolio/mkdocs/introduce/#_1","title":"\u4f7f\u7528\u4eba\u7fa4","text":"<ul> <li>\u6280\u672f\u6587\u6863\u7f16\u5199\u8005 </li> <li>\u6280\u672f\u5f00\u53d1\u4eba\u5458</li> <li>\u8fd0\u7ef4\u548c\u4ea7\u54c1\u56e2\u961f</li> </ul>"},{"location":"portfolio/mkdocs/introduce/#_2","title":"\u4e3b\u8981\u7279\u6027","text":"<ul> <li>\u7b80\u5355\u6e05\u6670\u7684\u9879\u76ee\u7ed3\u6784: <ul> <li>\u6587\u6863\u5185\u5bb9\u4e0e\u914d\u7f6e\u5206\u79bb,\u6587\u6863\u5185\u5bb9\u4ee5 Markdown \u6587\u4ef6\u5f62\u5f0f\u96c6\u4e2d\u7ba1\u7406,\u7ad9\u70b9\u7ed3\u6784\u548c\u5bfc\u822a\u901a\u8fc7\u914d\u7f6e\u6587\u4ef6\u7edf\u4e00\u5b9a\u4e49.\u8fd9\u79cd\u7ed3\u6784\u4f7f\u6587\u6863\u66f4\u6613\u7ef4\u62a4\uff0c\u4e5f\u4fbf\u4e8e\u56e2\u961f\u534f\u4f5c\u548c\u7248\u672c\u7ba1\u7406\u3002</li> </ul> </li> <li> <p>\u57fa\u4e8e\u914d\u7f6e\u7684\u5bfc\u822a\u7ba1\u7406</p> <ul> <li>MkDocs \u4f7f\u7528\u914d\u7f6e\u6587\u4ef6\u5b9a\u4e49\u6587\u6863\u5bfc\u822a\u7ed3\u6784\uff0c\u800c\u4e0d\u662f\u4f9d\u8d56\u6587\u4ef6\u76ee\u5f55\u7ed3\u6784\u81ea\u52a8\u751f\u6210\u5bfc\u822a\u3002\u8fd9\u79cd\u65b9\u5f0f\u53ef\u4ee5\u7075\u6d3b\u63a7\u5236\u9875\u9762\u987a\u5e8f\u548c\u5c42\u7ea7\uff0c\u9002\u5408\u6784\u5efa\u7ed3\u6784\u6e05\u6670\u7684\u7528\u6237\u624b\u518c\u548c\u5f00\u53d1\u6587\u6863\u3002</li> </ul> </li> <li> <p>\u5185\u7f6e\u5f00\u53d1\u670d\u52a1\u5668</p> <ul> <li>MkDocs \u63d0\u4f9b\u5185\u7f6e\u7684\u672c\u5730\u5f00\u53d1\u670d\u52a1\u5668\uff0c\u652f\u6301\u5b9e\u65f6\u9884\u89c8\u3002\u5728\u7f16\u5199\u6216\u4fee\u6539\u6587\u6863\u65f6\uff0c\u53ef\u4ee5\u5373\u65f6\u67e5\u770b\u9875\u9762\u6548\u679c\uff0c\u63d0\u9ad8\u6587\u6863\u7f16\u5199\u6548\u7387\u3002</li> </ul> </li> <li> <p>\u4e3b\u9898\u4e0e\u63d2\u4ef6\u6269\u5c55\u673a\u5236</p> <ul> <li>MkDocs \u652f\u6301\u901a\u8fc7\u4e3b\u9898\u548c\u63d2\u4ef6\u6269\u5c55\u529f\u80fd\uff1a\u4e3b\u9898\u7528\u4e8e\u63a7\u5236\u7ad9\u70b9\u7684\u6574\u4f53\u5916\u89c2\u548c\u5e03\u5c40,\u63d2\u4ef6\u7528\u4e8e\u589e\u5f3a\u6784\u5efa\u6d41\u7a0b\u548c\u529f\u80fd.\u6210\u719f\u7684\u751f\u6001\u7cfb\u7edf\u4f7f MkDocs \u80fd\u591f\u9002\u914d\u4e0d\u540c\u89c4\u6a21\u548c\u98ce\u683c\u7684\u6587\u6863\u9879\u76ee\u3002</li> </ul> </li> </ul>"},{"location":"portfolio/mkdocs/mkdocs-started/","title":"\u5feb\u901f\u4e0a\u624b","text":""},{"location":"portfolio/mkdocs/mkdocs-started/#_2","title":"\u4e00\u3001\u5b89\u88c5\u4e0e\u73af\u5883\u51c6\u5907","text":"<ul> <li>\u5b89\u88c5\u4e0e\u73af\u5883\u51c6\u5907 \u5728\u4f7f\u7528 MkDocs \u4e4b\u524d\uff0c\u8bf7\u5148\u5b8c\u6210\u4ee5\u4e0b\u73af\u5883\u51c6\u5907\u548c\u5b89\u88c5\u6b65\u9aa4\u3002</li> <li>\u73af\u5883\u8981\u6c42 MkDocs \u57fa\u4e8e Python \u5f00\u53d1\uff0c\u8bf7\u786e\u4fdd\u672c\u5730\u5df2\u5b89\u88c5 Python \u73af\u5883\u3002<ul> <li>Python \u7248\u672c\uff1a3.8 \u53ca\u4ee5\u4e0a</li> <li>\u64cd\u4f5c\u7cfb\u7edf\uff1aWindows\u3001macOS\u3001Linux \u5747\u53ef</li> </ul> </li> </ul> <p>\u4f60\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u547d\u4ee4\u786e\u8ba4 Python \u662f\u5426\u5df2\u5b89\u88c5\uff1a</p> <pre><code>python --version\n</code></pre> <p>\u6216\uff1a</p> <pre><code>python3 --version\n</code></pre> <p>\u5982\u679c\u672a\u5b89\u88c5 Python\uff0c\u8bf7\u5148\u524d\u5f80 Python \u5b98\u65b9\u7f51\u7ad9\u5b8c\u6210\u5b89\u88c5\u3002</p> <ul> <li>\u5b89\u88c5 MkDocs MkDocs \u53ef\u901a\u8fc7 Python \u7684\u5305\u7ba1\u7406\u5de5\u5177 pip \u8fdb\u884c\u5b89\u88c5\u3002</li> </ul> <pre><code>pip install mkdocs\n</code></pre> <p>\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u547d\u4ee4\u9a8c\u8bc1\u662f\u5426\u5b89\u88c5\u6210\u529f\uff1a</p> <pre><code>mkdocs --version\n</code></pre> <p>\u5982\u679c\u7ec8\u7aef\u8f93\u51fa MkDocs \u7684\u7248\u672c\u53f7\uff0c\u8bf4\u660e\u5b89\u88c5\u6210\u529f\u3002</p> <ul> <li>\u5e38\u89c1\u95ee\u9898\u8bf4\u660e<ul> <li>\u547d\u4ee4\u4e0d\u53ef\u7528     \u5982\u679c\u6267\u884c mkdocs \u547d\u4ee4\u63d0\u793a\u672a\u627e\u5230\u547d\u4ee4\uff0c\u8bf7\u786e\u8ba4\uff1a<ul> <li>Python \u548c pip \u5df2\u6b63\u786e\u5b89\u88c5</li> <li>pip \u7684\u5b89\u88c5\u8def\u5f84\u5df2\u52a0\u5165\u7cfb\u7edf\u73af\u5883\u53d8\u91cf</li> </ul> </li> <li>\u4f7f\u7528 pip3     \u5728\u90e8\u5206\u7cfb\u7edf\u4e2d\uff0c\u53ef\u80fd\u9700\u8981\u4f7f\u7528 pip3 \u4ee3\u66ff pip\uff1a</li> </ul> </li> </ul> <pre><code>        pip3 install mkdocs\n</code></pre>"},{"location":"portfolio/mkdocs/mkdocs-started/#_3","title":"\u521b\u5efa\u7b2c\u4e00\u4e2a\u9879\u76ee","text":"<ul> <li>\u6267\u884c\u4ee5\u4e0b\u547d\u4ee4</li> </ul> <pre><code>mkdocs new my-project\ncd my-project\nmkdocs serve\n</code></pre> <ul> <li>\u5728\u6d4f\u89c8\u5668\u4e2d\u6253\u5f00http://127.0.0.1:8000/\uff0c\u4f60\u5c06\u770b\u5230\u663e\u793a\u7684\u9ed8\u8ba4\u4e3b\u9875\uff1a</li> </ul>"},{"location":"portfolio/mkdocs/troubleshooting/","title":"\u5e38\u89c1\u95ee\u9898\u4e0e\u6545\u969c\u6392\u67e5","text":""},{"location":"portfolio/mkdocs/troubleshooting/#_1","title":"\u5e38\u89c1\u95ee\u9898\u4e0e\u6545\u969c\u6392\u67e5","text":""},{"location":"portfolio/mkdocs/troubleshooting/#yaml","title":"YAML \u4f7f\u7528\u6ce8\u610f\u4e8b\u9879","text":"<ul> <li>\u4f7f\u7528 \u7a7a\u683c \u8fdb\u884c\u7f29\u8fdb\uff0c\u4e0d\u80fd\u4f7f\u7528 Tab</li> <li>\u7f29\u8fdb\u5c42\u7ea7\u5fc5\u987b\u4fdd\u6301\u4e00\u81f4</li> <li>\u5192\u53f7\u540e\u5fc5\u987b\u6709\u4e00\u4e2a\u7a7a\u683c</li> </ul> <p>\u26a0\ufe0f \u7f29\u8fdb\u9519\u8bef\u662f MkDocs \u521d\u5b66\u8005\u6700\u5e38\u89c1\u7684\u95ee\u9898\u4e4b\u4e00\uff0c\u901a\u5e38\u4f1a\u5bfc\u81f4\u6784\u5efa\u5931\u8d25\u3002</p>"},{"location":"portfolio/mkdocs/troubleshooting/#_2","title":"\u5bfc\u822a\u95ee\u9898","text":"\u95ee\u9898\u73b0\u8c61 \u53ef\u80fd\u539f\u56e0 \u89e3\u51b3\u5efa\u8bae \u5bfc\u822a\u680f\u4e0d\u663e\u793a\u65b0\u589e\u9875\u9762 \u672a\u5728 <code>nav</code> \u4e2d\u6dfb\u52a0\u5bf9\u5e94\u6761\u76ee \u786e\u8ba4 <code>mkdocs.yml</code> \u4e2d <code>nav</code> \u914d\u7f6e\u6b63\u786e \u6784\u5efa\u62a5\u9519 \u6587\u4ef6\u8def\u5f84\u9519\u8bef\u6216\u5927\u5c0f\u5199\u4e0d\u5339\u914d \u68c0\u67e5\u8def\u5f84\u62fc\u5199\u548c\u6587\u4ef6\u662f\u5426\u5b58\u5728 \u5bfc\u822a\u5c42\u7ea7\u663e\u793a\u5f02\u5e38 YAML \u7f29\u8fdb\u9519\u8bef \u786e\u8ba4\u4f7f\u7528\u7a7a\u683c\u7f29\u8fdb\u4e14\u5c42\u7ea7\u5bf9\u5e94"}]}