{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6280\u672f\u5199\u4f5c\u5fc5\u8bfb\u535a\u5ba2","text":"<p>\u6280\u672f\u662f\u4e0d\u65ad\u6f14\u8fdb\u7684\u65c5\u7a0b\uff0c\u6211\u4e5f\u5728\u5b66\u4e60\u548c\u6210\u957f\u4e2d\uff0c\u5e0c\u671b\u901a\u8fc7\u8fd9\u7247\u7a7a\u95f4\uff0c\u4e0e\u5fd7\u540c\u9053\u5408\u7684\u670b\u53cb\u4e00\u8d77\u63a2\u7d22\u3001\u4ea4\u6d41\u548c\u8fdb\u6b65\u3002\u611f\u8c22\u4f60\u7684\u5230\u6765\uff0c\u671f\u5f85\u4e0e\u4f60\u5171\u540c\u8fdb\u6b65\uff01</p>"},{"location":"#_2","title":"\u4f5c\u54c1","text":""},{"location":"#1-mkdocs","title":"1. mkdocs","text":""},{"location":"#2material","title":"2.material","text":""},{"location":"about/","title":"About","text":"<p>\u5728\u8bbe\u8ba1\u5bfc\u822a\u7ed3\u6784\u65f6\uff0c\u5e94\u4f18\u5148\u8003\u8651\u8bfb\u8005\u7684\u9605\u8bfb\u4f53\u9a8c\uff1a</p> <p>\u5b66\u4e60\u8def\u5f84\u662f\u5426\u6e05\u6670</p> <p>\u662f\u5426\u7b26\u5408\u4ece\u6d45\u5230\u6df1\u7684\u903b\u8f91</p> <p>\u662f\u5426\u907f\u514d\u5bfc\u822a\u5c42\u7ea7\u8fc7\u6df1</p> <p>\u5bfc\u822a\u4e0d\u5fc5\u4e25\u683c\u53cd\u6620\u76ee\u5f55\u7ed3\u6784\uff0c\u800c\u5e94\u53cd\u6620\u5185\u5bb9\u7684\u903b\u8f91\u5173\u7cfb\u3002</p>"},{"location":"portfolio/material/introduce/","title":"material\u4e3b\u9898\u7528\u6237\u6307\u5357","text":"<p>\u656c\u8bf7\u671f\u5f85</p>"},{"location":"portfolio/mkdocs/advance-usage/","title":"\u9ad8\u7ea7\u7528\u6cd5","text":""},{"location":"portfolio/mkdocs/advance-usage/#_2","title":"\u4e00\u3001\u81ea\u5b9a\u4e49\u4e3b\u9898","text":"<p>MkDocs \u7684\u4e3b\u9898\u51b3\u5b9a\u4e86\u6587\u6863\u7f51\u7ad9\u7684\u6574\u4f53\u98ce\u683c\u548c\u5e03\u5c40\u3002\u9ed8\u8ba4\u4e3b\u9898\u5df2\u7ecf\u6ee1\u8db3\u4e86\u5927\u90e8\u5206\u9700\u6c42\uff0c\u4f46\u6709\u65f6\u6211\u4eec\u9700\u8981\u6839\u636e\u54c1\u724c\u6216\u8005\u7279\u6b8a\u9700\u6c42\u81ea\u5b9a\u4e49\u4e3b\u9898\u3002</p>"},{"location":"portfolio/mkdocs/advance-usage/#1","title":"1. \u4f7f\u7528\u7b2c\u4e09\u65b9\u4e3b\u9898","text":"<ul> <li>\u5b89\u88c5\u7b2c\u4e09\u65b9\u4e3b\u9898\u63d2\u4ef6,\u5982\u5b89\u88c5material\u4e3b\u9898:</li> </ul> <pre><code>    pip install mkdocs-material\n</code></pre> <ul> <li>\u5728 mkdocs.yml \u4e2d\u4fee\u6539\u4e3b\u9898\u540d\u79f0.\u5982:</li> </ul> <pre><code>    theme:\n        name: Material\n</code></pre> <ul> <li>\u7b2c\u4e09\u65b9\u4e3b\u9898\u63d2\u4ef6\u53c2\u8003\u94fe\u63a5</li> </ul>"},{"location":"portfolio/mkdocs/advance-usage/#2","title":"2. \u8986\u76d6\u9759\u6001\u8d44\u6e90","text":"<ul> <li>\u5982\u679c\u9700\u8981\u66f4\u7cbe\u7ec6\u7684\u6837\u5f0f\u8c03\u6574\uff0c\u5728\u9879\u76ee\u6839\u76ee\u5f55\u521b\u5efa docs/overrides \u6587\u4ef6\u5939\u3002</li> <li>\u5c06\u81ea\u5b9a\u4e49\u7684 CSS\u3001JavaScript \u6216\u56fe\u7247\u653e\u5165\u76f8\u5e94\u8def\u5f84\uff0cMkDocs \u4f1a\u8986\u76d6\u9ed8\u8ba4\u4e3b\u9898\u4e2d\u7684\u8d44\u6e90\u3002</li> </ul>"},{"location":"portfolio/mkdocs/advance-usage/#3","title":"3. \u81ea\u5b9a\u4e49\u6a21\u677f","text":"<ul> <li>MkDocs \u4e3b\u9898\u57fa\u4e8e Jinja2 \u6a21\u677f\u5f15\u64ce\u3002\u4f60\u53ef\u4ee5\u521b\u5efa\u6216\u4fee\u6539 HTML \u6a21\u677f\u6587\u4ef6\uff0c\u5b9e\u73b0\u5bf9\u9875\u9762\u7ed3\u6784\u7684\u81ea\u5b9a\u4e49\uff0c\u6bd4\u5982\u6dfb\u52a0\u9875\u811a\u4fe1\u606f\u6216\u8c03\u6574\u5bfc\u822a\u83dc\u5355\u3002</li> <li>jinja2\u53c2\u8003\u5730\u5740</li> </ul>"},{"location":"portfolio/mkdocs/advance-usage/#4","title":"4. \u6ce8\u610f\u4e8b\u9879","text":"<ul> <li>\u4fee\u6539\u4e3b\u9898\u540e\uff0c\u8bf7\u6e05\u7406\u6d4f\u89c8\u5668\u7f13\u5b58\u5e76\u91cd\u65b0\u6784\u5efa\u6587\u6863\uff0c\u4ee5\u786e\u4fdd\u6837\u5f0f\u751f\u6548\u3002\u4f7f\u7528\u6d4f\u89c8\u5668\u5f00\u53d1\u8005\u5de5\u5177\u53ef\u4ee5\u5e2e\u52a9\u5b9a\u4f4d\u6837\u5f0f\u95ee\u9898\u3002</li> </ul>"},{"location":"portfolio/mkdocs/advance-usage/#_3","title":"\u4e8c\u3001\u6587\u6863\u90e8\u7f72","text":""},{"location":"portfolio/mkdocs/advance-usage/#1github-pages","title":"1.\u90e8\u7f72GitHub Pages","text":"<ul> <li>\u786e\u4fdd\u4f60\u7684\u9879\u76ee\u5728GitHub \u4ed3\u5e93(\u5982\u679c\u4f60\u4e0d\u60f3\u5728github\u4e0a\u4fdd\u5b58\u6e90\u4ee3\u7801,\u90a3\u4e48\u53ea\u8981\u521b\u5efagithub\u4ed3\u5e93\u5373\u53ef)</li> <li>\u5728\u672c\u5730\u4f7f\u7528\u4ee5\u4e0b\u547d\u4ee4\uff1a</li> </ul> <pre><code>    mkdocs gh-deploy\n</code></pre> <p>\u8be5\u547d\u4ee4\u4f1a\u81ea\u52a8\u6784\u5efa\u9879\u76ee\u5e76\u5c06 site \u76ee\u5f55\u5185\u5bb9\u63a8\u9001\u5230 GitHub Pages \u5206\u652f\u3002</p> <ul> <li>\u5728\u547d\u4ee4\u884c\u7684\u6267\u884c\u4fe1\u606f\u4e2d\u7684\u6700\u540e\u4e00\u884c\u4f60\u53ef\u4ee5\u770b\u5230\u4f60\u7684\u6587\u6863\u5730\u5740,\u6253\u5f00\u8be5\u94fe\u63a5\u5730\u5740,\u5373\u53ef\u9884\u89c8\u3002</li> </ul>"},{"location":"portfolio/mkdocs/advance-usage/#2_1","title":"2. \u90e8\u7f72\u5230\u5176\u4ed6\u9759\u6001\u670d\u52a1\u5668","text":"<ul> <li>\u5c06 site \u76ee\u5f55\u5185\u5bb9\u4e0a\u4f20\u5230\u4f60\u7684\u670d\u52a1\u5668\u5bf9\u5e94\u7684\u9759\u6001\u8d44\u6e90\u76ee\u5f55\u5373\u53ef\u3002</li> </ul>"},{"location":"portfolio/mkdocs/advance-usage/#_4","title":"\u4e09\u3001\u6027\u80fd\u4e0e\u6784\u5efa\u4f18\u5316","text":"<p>\u4e3a\u4e86\u63d0\u5347\u7528\u6237\u8bbf\u95ee\u6587\u6863\u7684\u4f53\u9a8c\u548c\u52a0\u5feb\u672c\u5730\u6784\u5efa\u901f\u5ea6\uff0c\u6211\u4eec\u5efa\u8bae\u4ece\u4ee5\u4e0b\u51e0\u4e2a\u65b9\u9762\u8fdb\u884c\u4f18\u5316\uff1a</p> <ol> <li> <p>\u5408\u7406\u62c6\u5206\u6587\u6863\u5185\u5bb9:</p> <ul> <li>\u5c06\u5927\u578b\u6587\u6863\u62c6\u5206\u6210\u591a\u4e2a\u5c0f\u7ae0\u8282\uff0c\u907f\u514d\u5355\u4e2a\u6587\u4ef6\u8fc7\u5927\uff0c\u63d0\u5347\u6784\u5efa\u6548\u7387\u548c\u9875\u9762\u52a0\u8f7d\u901f\u5ea6\u3002</li> </ul> </li> <li> <p>\u63a7\u5236\u63d2\u4ef6\u6570\u91cf</p> <ul> <li>\u4ec5\u542f\u7528\u5fc5\u8981\u7684\u63d2\u4ef6\uff0c\u51cf\u5c11\u6784\u5efa\u65f6\u7684\u989d\u5916\u5904\u7406\u3002\u90e8\u5206\u63d2\u4ef6\u4f1a\u663e\u8457\u5f71\u54cd\u6784\u5efa\u65f6\u95f4\u3002</li> </ul> </li> <li> <p>\u8d44\u6e90\u4f18\u5316</p> <ul> <li>\u4f18\u5316\u56fe\u7247\u5927\u5c0f\uff0c\u51cf\u5c11 CSS \u548c JS \u6587\u4ef6\u4f53\u79ef\u3002\u5efa\u8bae\u4f7f\u7528\u73b0\u4ee3\u683c\u5f0f\u5982 WebP\u3002</li> </ul> </li> <li> <p>\u4f7f\u7528 CI/CD \u81ea\u52a8\u6784\u5efa\u4e0e\u90e8\u7f72</p> <ul> <li>\u901a\u8fc7\u81ea\u52a8\u5316\u6d41\u7a0b\u51cf\u8f7b\u672c\u5730\u8d1f\u62c5\uff0c\u786e\u4fdd\u6784\u5efa\u73af\u5883\u4e00\u81f4\u3002</li> </ul> </li> <li> <p>\u7248\u672c\u5347\u7ea7</p> <ul> <li>\u5b9a\u671f\u66f4\u65b0 MkDocs \u548c\u63d2\u4ef6\uff0c\u83b7\u53d6\u6027\u80fd\u6539\u8fdb\u548c\u65b0\u529f\u80fd\u3002</li> </ul> </li> <li> <p>\u89e3\u51b3\u5e38\u89c1\u95ee\u9898</p> <ul> <li>\u5982\u679c\u9047\u5230\u6784\u5efa\u901f\u5ea6\u6162\u6216\u4e3b\u9898\u52a0\u8f7d\u95ee\u9898\uff0c\u53ef\u5c1d\u8bd5\u7981\u7528\u63d2\u4ef6\u6216\u66f4\u6362\u4e3b\u9898\u8fdb\u884c\u6392\u67e5\u3002</li> </ul> </li> </ol>"},{"location":"portfolio/mkdocs/concepts/","title":"\u6838\u5fc3\u6982\u5ff5","text":""},{"location":"portfolio/mkdocs/concepts/#_2","title":"\u4e00\u3001\u6587\u6863\u6e90\u6587\u4ef6","text":"<ul> <li>MkDocs\u4e2d\u6587\u6863\u6e90\u6587\u4ef6\u662f\u7528Markdown\u683c\u5f0f\u7f16\u5199\u7684\u5185\u5bb9\uff0c\u901a\u5e38\u5b58\u653e\u5728docs\u76ee\u5f55\uff0c\u6784\u5efa\u65f6\u8f6c\u6362\u4e3a\u9759\u6001\u7f51\u9875\u3002</li> </ul>"},{"location":"portfolio/mkdocs/concepts/#_3","title":"\u4e8c\u3001\u4e3b\u9898","text":"<ul> <li>MkDocs \u4e3b\u9898\u63a7\u5236\u6587\u6863\u7f51\u7ad9\u7684\u5916\u89c2\u548c\u5e03\u5c40\uff0c\u5305\u62ec\u989c\u8272\u3001\u5b57\u4f53\u3001\u5bfc\u822a\u6837\u5f0f\uff0c\u5e2e\u52a9\u6253\u9020\u7edf\u4e00\u4e14\u7f8e\u89c2\u7684\u7528\u6237\u754c\u9762\u4f53\u9a8c\u3002</li> </ul>"},{"location":"portfolio/mkdocs/concepts/#_4","title":"\u4e09\u3001\u6784\u5efa","text":"<ul> <li>\u6784\u5efabuild\u7684\u542b\u4e49\u662f\u5c06\u4f60\u7684 Markdown \u6587\u6863\u8f6c\u6362\u6210\u9759\u6001\u7684 HTML \u7f51\u7ad9\u3002\u5b83\u4f1a\u6839\u636e\u4f60\u9879\u76ee\u4e2d\u7684 mkdocs.yml \u914d\u7f6e\u6587\u4ef6\u548c docs/ \u76ee\u5f55\u4e0b\u7684 Markdown \u6587\u4ef6\uff0c\u751f\u6210\u5b8c\u6574\u7684\u9759\u6001\u7f51\u9875\u6587\u4ef6\u3002\u751f\u6210\u7684\u7f51\u7ad9\u6587\u4ef6\u5b58\u653e\u5728 site/ \u76ee\u5f55\uff0c\u4f60\u53ef\u4ee5\u76f4\u63a5\u6253\u5f00\u8fd9\u4e9b\u6587\u4ef6\u67e5\u770b\uff0c\u4e5f\u53ef\u4ee5\u5c06\u5b83\u4eec\u4e0a\u4f20\u5230\u670d\u52a1\u5668\u6216\u90e8\u7f72\u5230 GitHub Pages \u7b49\u5e73\u53f0\u3002</li> </ul>"},{"location":"portfolio/mkdocs/concepts/#favicon","title":"\u56db\u3001Favicon\u56fe\u6807","text":"<p>MkDocs\u4e2d\u7684Favicon\u662f\u7f51\u7ad9\u6d4f\u89c8\u5668\u6807\u7b7e\u9875\u663e\u793a\u7684\u5c0f\u56fe\u6807\uff0c\u7528\u4e8e\u54c1\u724c\u8bc6\u522b\u548c\u63d0\u5347\u7528\u6237\u4f53\u9a8c\uff0c\u901a\u5e38\u901a\u8fc7\u914d\u7f6e\u6587\u4ef6\u8bbe\u7f6e\u3002</p>"},{"location":"portfolio/mkdocs/concepts/#mkdocsyml","title":"\u4e94\u3001mkdocs.yml\u914d\u7f6e\u9879\u8bf4\u660e","text":""},{"location":"portfolio/mkdocs/concepts/#1","title":"1. \u6982\u89c8","text":"<ul> <li>MkDocs \u4f7f\u7528 mkdocs.yml \u4f5c\u4e3a\u5168\u5c40\u914d\u7f6e\u6587\u4ef6\uff0c\u7528\u4e8e\u63a7\u5236\u6574\u4e2a\u6587\u6863\u7ad9\u70b9\u7684\u884c\u4e3a\u548c\u5916\u89c2\uff0c\u5305\u62ec\uff1a<ul> <li>\u7ad9\u70b9\u57fa\u672c\u4fe1\u606f\uff08\u540d\u79f0\u3001\u5730\u5740\u7b49\uff09</li> <li>\u5de6\u4fa7\u5bfc\u822a\u7ed3\u6784</li> <li>\u4e3b\u9898\u4e0e\u5916\u89c2\u8bbe\u7f6e</li> <li>\u63d2\u4ef6\u4e0e\u6269\u5c55\u529f\u80fd</li> </ul> </li> </ul>"},{"location":"portfolio/mkdocs/concepts/#2","title":"2. \u57fa\u672c\u7ed3\u6784","text":"<ul> <li>mkdocs.yml\u4f7f\u7528 YAML \u683c\u5f0f\u8fdb\u884c\u7f16\u5199\uff0c\u5176\u57fa\u672c\u5f62\u5f0f\u4e3a \u952e\u503c\u5bf9\uff08key: value\uff09\u3002\u6bd4\u5982</li> </ul> <pre><code>    site_name: My Docs\n</code></pre>"},{"location":"portfolio/mkdocs/concepts/#3","title":"3. \u6838\u5fc3\u914d\u7f6e\u9879\u8bf4\u660e","text":"<ul> <li>site_name\uff08\u7ad9\u70b9\u540d\u79f0\uff09:\u7528\u4e8e\u6307\u5b9a\u6587\u6863\u7ad9\u70b9\u7684\u540d\u79f0\uff0c\u901a\u5e38\u4f1a\u663e\u793a\u5728\uff1a\u6d4f\u89c8\u5668\u6807\u7b7e\u9875\u6807\u9898 \u548c \u9875\u9762\u9876\u90e8\u5bfc\u822a\u680f</li> </ul> <pre><code>    site_name: MkDocs \u7528\u6237\u6307\u5357\n</code></pre> <ul> <li>site_url\uff08\u7ad9\u70b9\u5730\u5740\uff0c\u53ef\u9009\uff09: \u7528\u4e8e\u6307\u5b9a\u7ad9\u70b9\u7684\u8bbf\u95ee\u5730\u5740\uff0c\u5728\u4ee5\u4e0b\u573a\u666f\u4e2d\u975e\u5e38\u6709\u7528\uff1a<ul> <li>\u90e8\u7f72\u5230 GitHub Pages</li> <li>\u542f\u7528 SEO \u6216\u7ad9\u70b9\u5730\u56fe\u63d2\u4ef6</li> </ul> </li> </ul> <pre><code>    site_url: https://example.github.io/mkdocs-guide/\n</code></pre> <ul> <li>nav\uff08\u5bfc\u822a\u914d\u7f6e\uff09:\u7528\u4e8e\u5b9a\u4e49\u6587\u6863\u7ad9\u70b9\u5de6\u4fa7\u7684\u5bfc\u822a\u7ed3\u6784\uff0c\u662f\u914d\u7f6e\u4e2d\u6700\u91cd\u8981\u3001\u4e5f\u6700\u5bb9\u6613\u51fa\u9519\u7684\u90e8\u5206\u3002<ul> <li>\u57fa\u672c\u89c4\u5219<ul> <li>\u5bfc\u822a\u987a\u5e8f\u4e0e <code>nav</code> \u4e2d\u7684\u5b9a\u4e49\u987a\u5e8f\u4e00\u81f4</li> <li>\u6587\u4ef6\u8def\u5f84\u5fc5\u987b\u771f\u5b9e\u5b58\u5728</li> <li>\u652f\u6301\u591a\u7ea7\u5bfc\u822a</li> </ul> </li> </ul> </li> </ul> <pre><code>    nav:\n    - \u9996\u9875: index.md\n    - \u5feb\u901f\u5f00\u59cb: getting-started.md\n    - \u4f7f\u7528\u6307\u5357:\n        - \u5b89\u88c5: guide/install.md\n        - \u914d\u7f6e\u6587\u4ef6\u8bf4\u660e: guide/configure\n</code></pre>"},{"location":"portfolio/mkdocs/how-to-guide/","title":"\u64cd\u4f5c\u6307\u5357","text":""},{"location":"portfolio/mkdocs/how-to-guide/#_2","title":"\u4e00\u3001\u65b0\u589e\u9875\u9762","text":""},{"location":"portfolio/mkdocs/how-to-guide/#1","title":"1.\u80cc\u666f:","text":"<p>\u5f53\u4f60\u9700\u8981\u8865\u5145\u65b0\u7684\u6587\u6863\u5185\u5bb9\uff0c\u5982\u65b0\u589e\u529f\u80fd\u8bf4\u660e\u3001FAQ\u3001\u6559\u7a0b\u7ae0\u8282\u7b49\uff0c\u5c31\u9700\u8981\u65b0\u589e\u9875\u9762\u3002</p>"},{"location":"portfolio/mkdocs/how-to-guide/#2","title":"2.\u57fa\u672c\u6d41\u7a0b:","text":"<ul> <li>\u5728 docs/ \u76ee\u5f55\u4e0b\u521b\u5efa\u65b0\u7684 Markdown \u6587\u4ef6</li> <li>\u7f16\u5199\u9875\u9762\u5185\u5bb9\uff08\u6dfb\u52a0\u6807\u9898\u548c\u6b63\u6587\uff09</li> <li>\u5728 mkdocs.yml \u914d\u7f6e\u6587\u4ef6\u4e2d\u5c06\u65b0\u9875\u9762\u52a0\u5165\u5bfc\u822a</li> <li>\u672c\u5730\u9884\u89c8\u6216\u6784\u5efa\u7ad9\u70b9\uff0c\u786e\u8ba4\u9875\u9762\u663e\u793a\u6b63\u5e38</li> </ul>"},{"location":"portfolio/mkdocs/how-to-guide/#3","title":"3.\u8be6\u7ec6\u6d41\u7a0b:","text":"<ol> <li> <p>\u521b\u5efa Markdown \u6587\u4ef6</p> <ul> <li>\u8fdb\u5165\u9879\u76ee\u4e2d\u7684 docs/ \u76ee\u5f55</li> <li>\u65b0\u5efa\u4e00\u4e2a .md \u683c\u5f0f\u7684\u6587\u4ef6\uff0c\u4f8b\u5982 new-feature.md</li> <li>\u5efa\u8bae\u6587\u4ef6\u540d\u4f7f\u7528\u5c0f\u5199\u5b57\u6bcd\u548c\u77ed\u6a2a\u7ebf\uff0c\u907f\u514d\u5927\u5c0f\u5199\u548c\u7a7a\u683c\u95ee\u9898</li> </ul> </li> <li> <p>\u7f16\u5199\u9875\u9762\u5185\u5bb9</p> <ul> <li>\u6253\u5f00\u65b0\u5efa\u7684 Markdown \u6587\u4ef6,\u6dfb\u52a0\u4e00\u7ea7\u6807\u9898\uff0c\u6807\u9898\u4f1a\u4f5c\u4e3a\u9875\u9762\u7684\u6807\u9898\u663e\u793a\u5728\u6d4f\u89c8\u5668\u548c\u5bfc\u822a\u4e2d</li> <li>\u6ce8\u610f\uff1a\u6587\u4ef6\u540d\u548c\u9875\u9762\u6807\u9898\u4e0d\u5fc5\u5b8c\u5168\u76f8\u540c\uff0c\u9875\u9762\u6807\u9898\u4ee5 Markdown \u4e2d\u7684\u4e00\u7ea7\u6807\u9898\u4e3a\u51c6\u3002</li> </ul> </li> <li>\u5c06\u9875\u9762\u52a0\u5165\u5bfc\u822a<ul> <li>\u6253\u5f00\u9879\u76ee\u6839\u76ee\u5f55\u4e0b\u7684 mkdocs.yml \u6587\u4ef6</li> <li>\u627e\u5230 nav \u914d\u7f6e\u9879</li> <li>\u6309\u7167\u5bfc\u822a\u5c42\u7ea7\uff0c\u65b0\u589e\u5bf9\u5e94\u9875\u9762\u7684\u8def\u5f84\uff08\u76f8\u5bf9\u4e8e docs/ \u76ee\u5f55\uff09</li> </ul> </li> </ol> <pre><code>    nav:\n        - \u9996\u9875: index.md\n        - \u65b0\u529f\u80fd:\n            - \u65b0\u529f\u80fd\u4ecb\u7ecd: new-feature.md\n</code></pre> <p>\u91cd\u8981\uff1a\u5982\u679c\u4e0d\u5c06\u9875\u9762\u52a0\u5165 nav\uff0c\u8be5\u9875\u9762\u4e0d\u4f1a\u663e\u793a\u5728\u5de6\u4fa7\u5bfc\u822a\u680f\u3002</p> <ol> <li>\u9884\u89c8\u9875\u9762\u6548\u679c<ul> <li>\u5728\u547d\u4ee4\u884c\u6267\u884c\uff1a<code>mkdocs serve</code></li> <li>\u6253\u5f00\u6d4f\u89c8\u5668\uff0c\u8bbf\u95ee\u9ed8\u8ba4\u5730\u5740 http://127.0.0.1:8000</li> <li>\u5728\u5de6\u4fa7\u5bfc\u822a\u680f\u627e\u5230\u65b0\u589e\u9875\u9762</li> <li>\u70b9\u51fb\u786e\u8ba4\u5185\u5bb9\u663e\u793a\u6b63\u5e38</li> </ul> </li> </ol>"},{"location":"portfolio/mkdocs/how-to-guide/#_3","title":"\u4e8c\u3001\u4f7f\u7528\u548c\u5207\u6362\u4e3b\u9898","text":""},{"location":"portfolio/mkdocs/how-to-guide/#1_1","title":"1. \u4e3b\u9898\u7b80\u4ecb","text":"<ul> <li>\u4e3b\u9898\u51b3\u5b9a\u4e86\u6587\u6863\u7ad9\u70b9\u7684\u6574\u4f53\u89c6\u89c9\u98ce\u683c\u548c\u5e03\u5c40\u3002MkDocs \u9ed8\u8ba4\u63d0\u4f9b\u4e86\u51e0\u4e2a\u5185\u7f6e\u4e3b\u9898\uff0c\u4e5f\u652f\u6301\u7b2c\u4e09\u65b9\u4e3b\u9898\uff0c\u5982\u5e7f\u53d7\u6b22\u8fce\u7684 Material \u4e3b\u9898\u3002\u4f60\u53ef\u4ee5\u5728 MkDocs \u5b98\u65b9\u6587\u6863\u67e5\u770b\u66f4\u591a\u4e3b\u9898\u4fe1\u606f\u3002</li> </ul>"},{"location":"portfolio/mkdocs/how-to-guide/#2_1","title":"2. \u914d\u7f6e\u4e3b\u9898","text":"<ul> <li>\u6587\u4ef6\u4f4d\u7f6e: <ul> <li>\u4e3b\u9898\u914d\u7f6e\u5199\u5728\u9879\u76ee\u6839\u76ee\u5f55\u4e0b\u7684 mkdocs.yml \u6587\u4ef6\u4e2d\uff0c\u901a\u8fc7 theme \u5173\u952e\u5b57\u6307\u5b9a\u3002</li> </ul> </li> <li>\u4f7f\u7528\u5185\u7f6e\u4e3b\u9898</li> </ul> <pre><code>    theme:\n        name: mkdocs\n</code></pre>"},{"location":"portfolio/mkdocs/how-to-guide/#favicon","title":"\u4e09\u3001\u66f4\u6539Favicon\u56fe\u6807","text":"<ol> <li>\u5728docs_dir\u4e2d\u521b\u5efa\u4e00\u4e2aimg\u5b50\u76ee\u5f55</li> </ol> <pre><code>    cd docs\n    mkdir img\n</code></pre> <ol> <li>\u5e76\u5c06\u81ea\u5b9a\u4e49\u7684favicon.ico\u6587\u4ef6\u590d\u5236\u5230\u8be5\u76ee\u5f55\u3002 </li> <li>MkDocs\u5c06\u81ea\u52a8\u68c0\u6d4b\u5e76\u4f7f\u7528\u8be5\u6587\u4ef6\u4f5c\u4e3a\u4f60\u7684favicon\u56fe\u6807\u3002</li> </ol>"},{"location":"portfolio/mkdocs/introduce/","title":"\u6982\u89c8","text":""},{"location":"portfolio/mkdocs/introduce/#mkdocs","title":"\u4e00\u3001\u4ec0\u4e48\u662fMkDocs","text":"<ul> <li>MkDocs \u662f\u4e00\u4e2a\u4ee5\u6587\u6863\u4e3a\u4e2d\u5fc3\u7684\u9759\u6001\u7ad9\u70b9\u751f\u6210\u5de5\u5177\uff0c\u5b83\u5c06\u5185\u5bb9\u3001\u7ed3\u6784\u548c\u6837\u5f0f\u6e05\u6670\u5206\u79bb\uff1a\u5185\u5bb9\u7528 Markdown \u7f16\u5199\uff0c\u7ed3\u6784\u901a\u8fc7\u914d\u7f6e\u6587\u4ef6\u5b9a\u4e49\uff0c\u6837\u5f0f\u7531\u4e3b\u9898\u63a7\u5236\u3002\u5b83\u7684\u8bbe\u8ba1\u76ee\u6807\u662f\u964d\u4f4e\u6587\u6863\u7ef4\u62a4\u6210\u672c\uff0c\u8ba9\u5f00\u53d1\u8005\u548c\u6587\u6863\u5de5\u7a0b\u5e08\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u5185\u5bb9\u672c\u8eab\u3002</li> </ul>"},{"location":"portfolio/mkdocs/introduce/#_2","title":"\u4e8c\u3001\u4f7f\u7528\u4eba\u7fa4","text":"<ul> <li>\u6280\u672f\u6587\u6863\u7f16\u5199\u8005 </li> <li>\u6280\u672f\u5f00\u53d1\u4eba\u5458</li> <li>\u8fd0\u7ef4\u548c\u4ea7\u54c1\u56e2\u961f</li> </ul>"},{"location":"portfolio/mkdocs/introduce/#_3","title":"\u4e09\u3001\u4e3b\u8981\u7279\u6027","text":"<ol> <li> <p>\u7b80\u5355\u6e05\u6670\u7684\u9879\u76ee\u7ed3\u6784</p> <ul> <li>\u6587\u6863\u5185\u5bb9\u4e0e\u914d\u7f6e\u5206\u79bb,\u6587\u6863\u5185\u5bb9\u4ee5 Markdown \u6587\u4ef6\u5f62\u5f0f\u96c6\u4e2d\u7ba1\u7406,\u7ad9\u70b9\u7ed3\u6784\u548c\u5bfc\u822a\u901a\u8fc7\u914d\u7f6e\u6587\u4ef6\u7edf\u4e00\u5b9a\u4e49.\u8fd9\u79cd\u7ed3\u6784\u4f7f\u6587\u6863\u66f4\u6613\u7ef4\u62a4\uff0c\u4e5f\u4fbf\u4e8e\u56e2\u961f\u534f\u4f5c\u548c\u7248\u672c\u7ba1\u7406\u3002</li> </ul> </li> <li> <p>\u57fa\u4e8e\u914d\u7f6e\u7684\u5bfc\u822a\u7ba1\u7406</p> <ul> <li>MkDocs \u4f7f\u7528\u914d\u7f6e\u6587\u4ef6\u5b9a\u4e49\u6587\u6863\u5bfc\u822a\u7ed3\u6784\uff0c\u800c\u4e0d\u662f\u4f9d\u8d56\u6587\u4ef6\u76ee\u5f55\u7ed3\u6784\u81ea\u52a8\u751f\u6210\u5bfc\u822a\u3002\u8fd9\u79cd\u65b9\u5f0f\u53ef\u4ee5\u7075\u6d3b\u63a7\u5236\u9875\u9762\u987a\u5e8f\u548c\u5c42\u7ea7\uff0c\u9002\u5408\u6784\u5efa\u7ed3\u6784\u6e05\u6670\u7684\u7528\u6237\u624b\u518c\u548c\u5f00\u53d1\u6587\u6863\u3002</li> </ul> </li> <li> <p>\u5185\u7f6e\u5f00\u53d1\u670d\u52a1\u5668</p> <ul> <li>MkDocs \u63d0\u4f9b\u5185\u7f6e\u7684\u672c\u5730\u5f00\u53d1\u670d\u52a1\u5668\uff0c\u652f\u6301\u5b9e\u65f6\u9884\u89c8\u3002\u5728\u7f16\u5199\u6216\u4fee\u6539\u6587\u6863\u65f6\uff0c\u53ef\u4ee5\u5373\u65f6\u67e5\u770b\u9875\u9762\u6548\u679c\uff0c\u63d0\u9ad8\u6587\u6863\u7f16\u5199\u6548\u7387\u3002</li> </ul> </li> <li> <p>\u4e3b\u9898\u4e0e\u63d2\u4ef6\u6269\u5c55\u673a\u5236</p> <ul> <li>MkDocs \u652f\u6301\u901a\u8fc7\u4e3b\u9898\u548c\u63d2\u4ef6\u6269\u5c55\u529f\u80fd\uff1a\u4e3b\u9898\u7528\u4e8e\u63a7\u5236\u7ad9\u70b9\u7684\u6574\u4f53\u5916\u89c2\u548c\u5e03\u5c40,\u63d2\u4ef6\u7528\u4e8e\u589e\u5f3a\u6784\u5efa\u6d41\u7a0b\u548c\u529f\u80fd\u3002\u6210\u719f\u7684\u751f\u6001\u7cfb\u7edf\u4f7f MkDocs \u80fd\u591f\u9002\u914d\u4e0d\u540c\u89c4\u6a21\u548c\u98ce\u683c\u7684\u6587\u6863\u9879\u76ee\u3002</li> </ul> </li> </ol>"},{"location":"portfolio/mkdocs/quich-start/","title":"\u5feb\u901f\u4e0a\u624b","text":""},{"location":"portfolio/mkdocs/quich-start/#mkdocs","title":"\u4e00\u3001\u5b89\u88c5MkDocs","text":""},{"location":"portfolio/mkdocs/quich-start/#1","title":"1. \u5b89\u88c5\u4e0e\u73af\u5883\u51c6\u5907","text":"<ul> <li>MkDocs \u57fa\u4e8e Python \u5f00\u53d1\uff0c\u8bf7\u786e\u4fdd\u672c\u5730\u5df2\u5b89\u88c5 Python \u73af\u5883\u3002<ul> <li>Python \u7248\u672c\uff1a3.8 \u53ca\u4ee5\u4e0a</li> <li>\u64cd\u4f5c\u7cfb\u7edf\uff1aWindows\u3001macOS\u3001Linux \u5747\u53ef</li> </ul> </li> </ul> <p>\u6ce8: \u4f60\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u547d\u4ee4\u786e\u8ba4 Python \u662f\u5426\u5df2\u5b89\u88c5\uff1a</p> <pre><code>    python --version\n</code></pre> <p>\u6216\uff1a</p> <pre><code>    python3 --version\n</code></pre> <p>\u5982\u679c\u672a\u5b89\u88c5 Python\uff0c\u8bf7\u5148\u524d\u5f80 Python \u5b98\u65b9\u7f51\u7ad9\u5b8c\u6210\u5b89\u88c5\u3002</p>"},{"location":"portfolio/mkdocs/quich-start/#2-mkdocs","title":"2.\u5b89\u88c5 MkDocs","text":"<p>MkDocs \u53ef\u901a\u8fc7 Python \u7684\u5305\u7ba1\u7406\u5de5\u5177 pip \u8fdb\u884c\u5b89\u88c5\u3002</p> <pre><code>    pip install mkdocs\n</code></pre>"},{"location":"portfolio/mkdocs/quich-start/#3","title":"3. \u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u547d\u4ee4\u9a8c\u8bc1\u662f\u5426\u5b89\u88c5\u6210\u529f\uff1a","text":"<pre><code>    mkdocs --version\n</code></pre> <p>\u5982\u679c\u7ec8\u7aef\u8f93\u51fa MkDocs \u7684\u7248\u672c\u53f7\uff0c\u8bf4\u660e\u5b89\u88c5\u6210\u529f\u3002</p>"},{"location":"portfolio/mkdocs/quich-start/#_2","title":"\u4e8c\u3001 \u521b\u5efa\u7b2c\u4e00\u4e2a\u9879\u76ee","text":""},{"location":"portfolio/mkdocs/quich-start/#1_1","title":"1. \u6267\u884c\u547d\u4ee4","text":"<pre><code>    mkdocs new my-project\n    cd my-project\n    mkdocs serve\n</code></pre>"},{"location":"portfolio/mkdocs/quich-start/#2","title":"2. \u6d4f\u89c8\u7f51\u7ad9","text":"<ul> <li>\u5728\u6d4f\u89c8\u5668\u4e2d\u6253\u5f00http://127.0.0.1:8000/\uff0c\u4f60\u5c06\u770b\u5230\u663e\u793a\u7684\u9ed8\u8ba4\u4e3b\u9875\uff1a</li> </ul>"},{"location":"portfolio/mkdocs/troubleshooting/","title":"\u5e38\u89c1\u95ee\u9898\u4e0e\u6545\u969c\u6392\u67e5","text":""},{"location":"portfolio/mkdocs/troubleshooting/#_2","title":"\u4e00\u3001\u5b89\u88c5\u4e0e\u73af\u5883","text":"<ul> <li>\u5b89\u88c5MkDocs\u65f6,\u663e\u793a\u547d\u4ee4\u4e0d\u53ef\u7528         \u5982\u679c\u6267\u884c <code>mkdocs</code> \u547d\u4ee4\u63d0\u793a\u672a\u627e\u5230\u547d\u4ee4\uff0c\u8bf7\u786e\u8ba4\uff1a         - Python \u548c pip \u5df2\u6b63\u786e\u5b89\u88c5         - pip \u7684\u5b89\u88c5\u8def\u5f84\u5df2\u52a0\u5165\u7cfb\u7edf\u73af\u5883\u53d8\u91cf<ul> <li>\u4f7f\u7528 pip3     \u5728\u90e8\u5206\u7cfb\u7edf\u4e2d\uff0c\u53ef\u80fd\u9700\u8981\u4f7f\u7528 pip3 \u4ee3\u66ff pip\uff1a</li> </ul> </li> </ul> <pre><code>    pip3 install mkdocs\n</code></pre>"},{"location":"portfolio/mkdocs/troubleshooting/#_3","title":"\u4e8c\u3001\u914d\u7f6e\u95ee\u9898","text":""},{"location":"portfolio/mkdocs/troubleshooting/#1yaml","title":"1.YAML \u4f7f\u7528\u6ce8\u610f\u4e8b\u9879","text":"<ul> <li>\u4f7f\u7528 \u7a7a\u683c \u8fdb\u884c\u7f29\u8fdb\uff0c\u4e0d\u80fd\u4f7f\u7528 Tab</li> <li>\u7f29\u8fdb\u5c42\u7ea7\u5fc5\u987b\u4fdd\u6301\u4e00\u81f4</li> <li>\u5192\u53f7\u540e\u5fc5\u987b\u6709\u4e00\u4e2a\u7a7a\u683c</li> </ul> <p>\u26a0\ufe0f \u7f29\u8fdb\u9519\u8bef\u662f MkDocs \u521d\u5b66\u8005\u6700\u5e38\u89c1\u7684\u95ee\u9898\u4e4b\u4e00\uff0c\u901a\u5e38\u4f1a\u5bfc\u81f4\u6784\u5efa\u5931\u8d25\u3002</p>"},{"location":"portfolio/mkdocs/troubleshooting/#2","title":"2. \u5bfc\u822a\u95ee\u9898","text":"\u95ee\u9898\u73b0\u8c61 \u53ef\u80fd\u539f\u56e0 \u89e3\u51b3\u5efa\u8bae \u5bfc\u822a\u680f\u4e0d\u663e\u793a\u65b0\u589e\u9875\u9762 \u672a\u5728 <code>nav</code> \u4e2d\u6dfb\u52a0\u5bf9\u5e94\u6761\u76ee \u786e\u8ba4 <code>mkdocs.yml</code> \u4e2d <code>nav</code> \u914d\u7f6e\u6b63\u786e \u6784\u5efa\u62a5\u9519 \u6587\u4ef6\u8def\u5f84\u9519\u8bef\u6216\u5927\u5c0f\u5199\u4e0d\u5339\u914d \u68c0\u67e5\u8def\u5f84\u62fc\u5199\u548c\u6587\u4ef6\u662f\u5426\u5b58\u5728 \u5bfc\u822a\u5c42\u7ea7\u663e\u793a\u5f02\u5e38 YAML \u7f29\u8fdb\u9519\u8bef \u786e\u8ba4\u4f7f\u7528\u7a7a\u683c\u7f29\u8fdb\u4e14\u5c42\u7ea7\u5bf9\u5e94"},{"location":"portfolio/mkdocs/troubleshooting/#_4","title":"\u4e09\u3001\u57fa\u672c\u64cd\u4f5c","text":""},{"location":"portfolio/mkdocs/troubleshooting/#_5","title":"\u56db\u3001\u9ad8\u7ea7\u7528\u6cd5","text":""}]}